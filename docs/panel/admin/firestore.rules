rules_version = '2';

// ============================================================
// Viza Chat - Firestore Rules
// Versi panel developer:
//  - owner  : bangexx01@gmail.com (selalu boleh)
//  - admin   : email yang terdaftar di koleksi panelAdmins
//  - user    : hanya data miliknya sendiri
// Tempel seluruh isi file ini ke Firebase Console
//   -> Firestore Database -> Rules -> Publish
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Owner panel (email tetap)
    function isPemilik() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == "bangexx01@gmail.com";
    }

    // Admin yang didaftarkan lewat menu Pengaturan di panel
    function terdaftarPanel() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/panelAdmins/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/panelAdmins/$(request.auth.token.email.lower())).data.aktif == true;
    }

    function isAdmin() {
      return isPemilik() || terdaftarPanel();
    }

    // ---------- akun panel developer ----------
    // Dibaca supaya panel tahu siapa yang boleh masuk.
    // Hanya owner yang boleh menambah atau mencabut admin.
    // Peta nama admin -> email, dipakai layar login (cari email dari nama).
    // Hanya boleh dibaca satu dokumen demi satu, tidak boleh didaftar semua.
    match /panelNama/{nama} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    match /panelAdmins/{email} {
      allow read: if signedIn();
      allow write: if isPemilik();
    }

    // Jabatan di APK per UID: dibaca aplikasi untuk memunculkan Panel Manager.
    match /stafApk/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /panelStok/{email} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Hanya email terdaftar yang boleh menulis daftar admin.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /userIds/{id} {
      allow read: if signedIn();
      // user boleh mengurus dokumennya sendiri, admin panel boleh membuat untuk user baru
      allow create, update: if signedIn()
        && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /counters/{doc} {
      allow read, write: if signedIn();
    }

    match /wallets/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /visits/{uid}/logs/{visitor} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- ranking ----------
    match /rank_sawer/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.subject == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /rank_room/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /rank_charm/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // ---------- room ----------
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin())
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());

      match /{sub=**} {
        allow read, write: if signedIn();
      }
    }

    match /invites/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      allow update, delete: if isAdmin();
    }

    match /follows/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.followerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    // ---------- chat ----------
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members.toSet() == resource.data.members.toSet();

      match /messages/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn()
          && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.from == request.auth.uid;
      }
    }

    match /moments/{momentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount'])
      );
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if isOwner(uid);
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    // ---------- katalog yang dikelola panel ----------
    match /gifts/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /frames/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /banners/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /vipConfig/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /games/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /gameConfig/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /banned/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /adminLogs/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- keluarga ----------
    match /families/{fid} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());

      match /{sub=**} {
        allow read: if signedIn();
        allow write: if signedIn();
      }
    }

    match /familyMembers/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
