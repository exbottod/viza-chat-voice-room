rules_version = '2';

// ============================================================
// Viza Chat - Firebase Storage Rules
// Tempel ke Firebase Console > Storage > Rules > Publish
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isPemilik() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == "bangexx01@gmail.com";
    }

    function terdaftarPanel() {
      return signedIn()
        && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/panelAdmins/$(request.auth.token.email.lower()))
        && firestore.get(/databases/(default)/documents/panelAdmins/$(request.auth.token.email.lower())).data.aktif == true;
    }

    function isAdmin() {
      return isPemilik() || terdaftarPanel();
    }

    // Semua aset (frame, VIP, badge ID, banner, stiker)
    // dibaca siapa saja supaya bisa tampil di aplikasi dan web,
    // tetapi hanya admin panel yang boleh mengunggah atau menghapus.
    match /aset/{folder}/{berkas} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 20 * 1024 * 1024;
    }

    match /{semua=**} {
      allow read, write: if false;
    }
  }
}
